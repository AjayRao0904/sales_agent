# Bind locally by default. Use an HTTPS reverse proxy for a remote deployment.
HOST=127.0.0.1
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Optional bootstrapped Gmail senders. Credentials can also be entered in Settings.
SMTP_A_EMAIL=
SMTP_A_PASSWORD=
SMTP_B_EMAIL=
SMTP_B_PASSWORD=
# Set to 1 only behind HTTPS; enables secure session cookies.
COOKIE_SECURE=0
