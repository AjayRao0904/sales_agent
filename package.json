    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.7.4",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.12"
